  "devDependencies": {
    "@book000/eslint-config": "1.16.111",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.9.10",
    "run-z": "2.1.0",
    "typescript": "6.0.3"
  },
  "homepage": "https://github.com/book000/chrome-response-recorder",
