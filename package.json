  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.116",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.9.10",
    "run-z": "2.1.0",
    "typescript": "6.0.3"
  },
  "homepage": "https://github.com/book000/chrome-response-recorder",
  "license": "MIT",
  "main": "dist/main.js",
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
