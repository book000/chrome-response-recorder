{
  "name": "chrome-response-recorder",
  "description": "Records HTTP responses and console logs from a Chromium browser driven by Puppeteer, in Docker with VNC",
  "version": "0.0.0",
  "author": "Tomachi <tomachi@tomacheese.com>",
  "bugs": {
    "url": "https://github.com/book000/chrome-response-recorder/issues"
  },
  "dependencies": {
    "puppeteer-core": "25.18.1",
    "tsx": "4.23.15",
    "otplib": "13.6.0"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.17.2",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.10.1",
    "run-z": "2.1.0",
    "typescript": "6.0.3"
  },
  "homepage": "https://github.com/book000/chrome-response-recorder",
  "license": "MIT",
  "main": "dist/main.js",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "private": true,
  "repository": {
    "url": "git@github.com:book000/chrome-response-recorder.git",
    "type": "git"
  },
  "scripts": {
    "dev": "tsx watch ./src/main.ts",
    "fix": "run-z fix:prettier fix:eslint",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "lint:prettier": "prettier --check src",
    "lint:tsc": "tsc",
    "preinstall": "npx only-allow pnpm",
    "start": "tsx ./src/main.ts",
    "test": "tsx --test src/response-directory.test.ts src/addon/active-addons.test.ts src/addon/twitter-login.test.ts src/target-url-regexes.test.ts src/redact-url.test.ts src/private-fs.test.ts src/main.test.ts"
  }
}
